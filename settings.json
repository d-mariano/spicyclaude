{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(uv run pytest)",
      "Bash(uv run mypy)",
      "Bash(uv run pyright)",
      "Bash(uv run ty)",
      "Bash(uv run ruff)",
      "Bash(poetry run pytest)",
      "Bash(poetry run mypy)",
      "Bash(poetry run pyright)",
      "Bash(poetry run ty)",
      "Bash(poetry run ruff)"
    ],
    "deny": [
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh"
}
