{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d-mariano/spicyclaude/spicy-ship/question-policy/question.schema.json",
  "title": "Open question",
  "description": "A question an agent could not resolve from its inputs, shaped so the main session can relay it through AskUserQuestion unchanged.",
  "type": "object",
  "required": ["id", "phase", "header", "question", "options", "reversibility", "impact"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^Q[0-9]+$"},
    "phase": {"type": "string", "minLength": 1},
    "header": {"type": "string", "minLength": 1, "maxLength": 12},
    "question": {"type": "string", "minLength": 1, "description": "States which AC, finding, or constraint rides on the answer."},
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "description"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "pattern": "·\\s*Counter:", "description": "<implication> · Counter: <trade-off>"},
          "preview": {"type": "string", "description": "Code or layout mockup for concrete-shape choices; single-select only."}
        }
      }
    },
    "recommended": {"type": "string", "description": "Label of the first option, which ends with (Recommended). Omit when the inputs give no evidence-backed lean; the question is then guarded in auto mode."},
    "reversibility": {"enum": ["reversible", "costly", "irreversible"]},
    "impact": {"enum": ["local", "cross-story", "external"]},
    "multiSelect": {"type": "boolean", "default": false}
  }
}
